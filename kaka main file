<script>
AOS.init();

// Placeholder product data — replace with real products, prices & photos
const products = [
  { name: "Fresh Tomatoes", price: "PKR 120/kg", cat: "grocery", img: "https://images.unsplash.com/photo-1546470427-e26264be0b0d?q=80&w=600&auto=format&fit=crop" },
  { name: "Red Apples", price: "PKR 280/kg", cat: "grocery", img: "https://images.unsplash.com/photo-1560806887-1e4cd0b6cbd6?q=80&w=600&auto=format&fit=crop" },
  { name: "Fresh Milk (1L)", price: "PKR 220", cat: "grocery", img: "https://images.unsplash.com/photo-1550583724-b2692b85b150?q=80&w=600&auto=format&fit=crop" },
  { name: "Basmati Rice (5kg)", price: "PKR 1,450", cat: "grocery", img: "https://images.unsplash.com/photo-1586201375761-83865001e31c?q=80&w=600&auto=format&fit=crop" },
  { name: "Gold Plated Necklace", price: "PKR 2,500", cat: "jewelry", img: "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?q=80&w=600&auto=format&fit=crop" },
  { name: "Pearl Earrings", price: "PKR 1,200", cat: "jewelry", img: "https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?q=80&w=600&auto=format&fit=crop" },
  { name: "Designer Bangles Set", price: "PKR 900", cat: "jewelry", img: "https://images.unsplash.com/photo-1611591437281-460bfbe1220a?q=80&w=600&auto=format&fit=crop" },
  { name: "Matte Lipstick Set", price: "PKR 1,500", cat: "makeup", img: "https://images.unsplash.com/photo-1586495777744-4413f21062fa?q=80&w=600&auto=format&fit=crop" },
  { name: "Foundation & Concealer Kit", price: "PKR 2,200", cat: "makeup", img: "https://images.unsplash.com/photo-1512496015851-a90fb38ba796?q=80&w=600&auto=format&fit=crop" },
  { name: "Eyeshadow Palette", price: "PKR 1,800", cat: "makeup", img: "https://images.unsplash.com/photo-1583241800698-e8ab01c85b31?q=80&w=600&auto=format&fit=crop" },
  { name: "Embroidered Kurti", price: "PKR 3,200", cat: "clothing", img: "https://images.unsplash.com/photo-1520367445093-50dc08a59d9d?q=80&w=600&auto=format&fit=crop" },
  { name: "Casual Summer Dress", price: "PKR 2,800", cat: "clothing", img: "https://images.unsplash.com/photo-1595777457583-95e059d581b8?q=80&w=600&auto=format&fit=crop" }
];

const grid = document.getElementById('product-grid');
function renderProducts(filter) {
  grid.innerHTML = '';
  products.filter(p => filter === 'all' || p.cat === filter).forEach((p, i) => {
    const card = document.createElement('div');
    card.className = "bg-white rounded-2xl overflow-hidden shadow-md card-hover";
    card.setAttribute('data-aos', 'fade-up');
    card.setAttribute('data-aos-delay', (i % 4) * 100);
    card.innerHTML = `
      <div class="h-48 overflow-hidden"><img src="${p.img}" alt="${p.name}" class="w-full h-full object-cover hover:scale-110 transition duration-500"></div>
      <div class="p-5">
        <h3 class="font-bold text-lg mb-2">${p.name}</h3>
        <div class="flex items-center justify-between">
          <span class="price-tag font-bold px-3 py-1 rounded-full text-sm">${p.price}</span>
          <button class="bg-[#1a1512] hover:bg-[#3a2a20] text-[#e8c27a] w-9 h-9 rounded-full text-lg transition">+</button>
        </div>
      </div>`;
    grid.appendChild(card);
  });
  AOS.refresh();
}
renderProducts('all');

document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderProducts(btn.dataset.filter);
  });
});

// Navbar background on scroll
const navbar = document.getElementById('navbar');
window.addEventListener('scroll', () => {
  if (window.scrollY > 40) {
    navbar.classList.add('bg-[#1a1512]/90', 'backdrop-blur', 'shadow-lg');
  } else {
    navbar.classList.remove('bg-[#1a1512]/90', 'backdrop-blur', 'shadow-lg');
  }
});

// GSAP hero entrance
gsap.from("#home h1", { opacity: 0, y: 40, duration: 1, ease: "power3.out" });
gsap.from("#home p", { opacity: 0, y: 30, duration: 1, delay: 0.2, ease: "power3.out" });
</script>
